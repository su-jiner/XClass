<view class="tabbar {{dark ? 'tabbar-dark' : ''}}">
  <view
    wx:for="{{list}}"
    wx:key="pagePath"
    class="tabbar-item"
    data-index="{{index}}"
    bindtap="switchTab"
  >
    <view
      class="tabbar-capsule"
      style="background:{{index === selected ? palette.panelAlt : 'transparent'}}"
    >
      <image class="tabbar-icon" src="{{index === selected ? item.iconActive : item.iconNormal}}" mode="aspectFit" />
      <view class="tabbar-text" style="color:{{index === selected ? palette.iconTint : palette.textSecondary}}">{{item.text}}</view>
    </view>
  </view>
</view>
