<view class="tabbar" style="background:{{palette.nav}};border-color:{{palette.panelAlt}}">
  <view
    wx:for="{{list}}"
    wx:key="pagePath"
    class="tabbar-item"
    data-index="{{index}}"
    bindtap="switchTab"
    style="color:{{index === selected ? palette.icon : palette.textSecondary}}"
  >
    <view class="tabbar-icon">{{item.icon}}</view>
    <view class="tabbar-text">{{item.text}}</view>
  </view>
</view>
