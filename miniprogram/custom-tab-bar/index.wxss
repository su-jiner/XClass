.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 110rpx;
  display: flex;
  border-top: 1rpx solid;
  padding-bottom: env(safe-area-inset-bottom);
}

.tabbar-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
}

.tabbar-icon {
  font-size: 34rpx;
  line-height: 40rpx;
}

.tabbar-text {
  margin-top: 2rpx;
}
