.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  padding: 6rpx 0 calc(6rpx + env(safe-area-inset-bottom));
}

.tabbar-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tabbar-capsule {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 8rpx 26rpx;
  border-radius: 32rpx;
  min-width: 108rpx;
}

.tabbar-icon {
  width: 40rpx;
  height: 40rpx;
}

.tabbar-text {
  font-size: 20rpx;
  margin-top: 2rpx;
}
