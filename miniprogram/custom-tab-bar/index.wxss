.tabbar {
  position: fixed;
  left: 12rpx;
  right: 12rpx;
  bottom: 12rpx;
  display: flex;
  padding: 8rpx;
  border-radius: 48rpx;
  background: rgba(255, 255, 255, 0.72);
  border: 1rpx solid rgba(128, 128, 128, 0.18);
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.10);
  box-sizing: border-box;
}

/* 深色模式玻璃容器（跟随页面深色状态） */
.tabbar-dark {
  background: rgba(18, 18, 22, 0.72);
  border-color: rgba(255, 255, 255, 0.10);
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.35);
}

.tabbar-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tabbar-capsule {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 8rpx 26rpx;
  border-radius: 36rpx;
  min-width: 108rpx;
}

.tabbar-icon {
  width: 40rpx;
  height: 40rpx;
}

.tabbar-text {
  font-size: 20rpx;
  margin-top: 2rpx;
}
