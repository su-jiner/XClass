
.groups-summary {
  font-size: 24rpx;
  padding: 16rpx 8rpx;
}

.course-card {
  padding: 16rpx 0;
}

.course-ops {
  display: flex;
  gap: 20rpx;
}

.course-op-sep {
  color: #9AA0B0;
}

.edit-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 200;
  display: flex;
  align-items: center;
  justify-content: center;
}

.manual-panel {
  width: 640rpx;
  max-height: 80vh;
  border-radius: 24rpx;
  padding: 32rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  overflow-y: auto;
}

.manual-title {
  font-size: 34rpx;
  font-weight: 700;
  text-align: center;
  margin-bottom: 24rpx;
}

.manual-field {
  margin-bottom: 20rpx;
}

.manual-row {
  display: flex;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.manual-half {
  flex: 1;
  min-width: 0;
}

.manual-label {
  font-size: 22rpx;
  margin-bottom: 8rpx;
}

.manual-input {
  width: 100%;
  height: 76rpx;
  border-radius: 14rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  font-size: 26rpx;
}

.manual-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  line-height: 76rpx;
}

.manual-ph {
  color: #9AA0B0;
}

.manual-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 28rpx;
}

.manual-btn {
  flex: 1;
  height: 84rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
}

.manual-btn-primary {
  font-weight: 700;
}
