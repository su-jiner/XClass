.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  padding: 0 12rpx calc(112rpx + env(safe-area-inset-bottom));
}

.header {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  padding: 8rpx 8rpx 12rpx;
}

.header-left {
  display: flex;
  align-items: center;
}

.header-week {
  font-size: 34rpx;
  font-weight: 700;
}

.header-date {
  font-size: 22rpx;
  padding-top: 4rpx;
}

.add-button {
  width: 72rpx;
  height: 72rpx;
  border-radius: 36rpx;
  font-size: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 24rpx;
}

.grid {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
}

.grid-head {
  flex: 0 0 auto;
  display: flex;
  gap: 8rpx;
}

.grid-body {
  flex: 1;
  min-height: 0;
  height: 100%;
}

/* 表头：整块圆角（与 Android buildHeader 一致） */
.head-time {
  flex: 0 0 104rpx;
  height: 84rpx;
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 700;
}

.head-day {
  flex: 1;
  min-width: 0;
  height: 84rpx;
  border-radius: 10rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.day-label {
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.1;
}

.day-date {
  font-size: 20rpx;
  opacity: 0.85;
  line-height: 1.2;
}

/* 主体：左侧时间列 + 右侧 7 个整列长条面板 */
.grid-main {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 8rpx;
  height: 100%;
}

.time-column {
  flex: 0 0 104rpx;
}

.time-cell {
  border-radius: 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  box-sizing: border-box;
  margin-bottom: 2rpx;
}

.section-no {
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.1;
}

.section-time {
  font-size: 18rpx;
  line-height: 1.15;
}

/* 列面板：一整条圆角，无横向分隔（Android buildDayColumn） */
.day-panel {
  flex: 1;
  min-width: 0;
  position: relative;
  border-radius: 10rpx;
  overflow: hidden;
}

/* 课程卡：列内绝对定位，浮在长条面板上 */
.course-card {
  position: absolute;
  left: 4rpx;
  width: calc(100% - 8rpx);
  box-sizing: border-box;
  border-radius: 10rpx;
  padding: 6rpx 4rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(60, 40, 20, 0.12);
}

.course-badge {
  font-size: 15rpx;
  opacity: 0.85;
  line-height: 1.15;
  margin-bottom: 1rpx;
}

.course-name {
  font-weight: 600;
  line-height: 1.15;
  text-align: center;
  word-break: break-all;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
}

.course-detail {
  font-size: 17rpx;
  line-height: 1.1;
  opacity: 0.85;
  text-align: center;
  word-break: break-all;
  margin-top: 2rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.week-hint {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 20rpx;
  padding: 6rpx 8rpx 0;
}

.week-arrow {
  padding: 4rpx 8rpx;
}

.week-current {
  opacity: 0.85;
}

.notes-bar {
  flex: 0 0 auto;
  margin: 8rpx 8rpx 0;
  border-radius: 12rpx;
  padding: 12rpx 20rpx;
  max-height: 200rpx;
  overflow-y: auto;
}

.notes-item {
  font-size: 22rpx;
  line-height: 1.6;
}

.manual-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 200;
  display: flex;
  align-items: center;
  justify-content: center;
}

.manual-panel {
  width: 640rpx;
  max-height: 80vh;
  border-radius: 24rpx;
  padding: 32rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  overflow-y: auto;
}

.manual-title {
  font-size: 34rpx;
  font-weight: 700;
  text-align: center;
  margin-bottom: 24rpx;
}

.manual-field {
  margin-bottom: 20rpx;
}

.manual-row {
  display: flex;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.manual-half {
  flex: 1;
  min-width: 0;
}

.manual-label {
  font-size: 22rpx;
  margin-bottom: 8rpx;
}

.manual-input {
  width: 100%;
  height: 76rpx;
  border-radius: 14rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  font-size: 26rpx;
}

.manual-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  line-height: 76rpx;
}

.manual-ph {
  color: #9AA0B0;
}

.manual-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 28rpx;
}

.manual-btn {
  flex: 1;
  height: 84rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
}

.manual-btn-primary {
  font-weight: 700;
}

.paste-area {
  width: 100%;
  height: 320rpx;
  border-radius: 14rpx;
  padding: 20rpx;
  box-sizing: border-box;
  font-size: 26rpx;
  line-height: 40rpx;
  margin-top: 12rpx;
}
