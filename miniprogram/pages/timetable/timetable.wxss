.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  padding: 0 12rpx calc(112rpx + env(safe-area-inset-bottom));
}

.header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 8rpx 8rpx 12rpx;
}

.header-week {
  font-size: 34rpx;
  font-weight: 700;
}

.header-date {
  font-size: 22rpx;
  padding-top: 4rpx;
}

.add-button {
  width: 72rpx;
  height: 72rpx;
  border-radius: 36rpx;
  font-size: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.grid {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
}

.grid-head {
  flex: 0 0 auto;
}

.grid-body {
  flex: 1;
  min-height: 0;
  height: 100%;
}

.grid-row {
  display: flex;
  height: 96rpx;
}

.grid-head .cell {
  height: 76rpx;
}

.cell {
  flex: 1;
  min-width: 0;
  margin: 2rpx;
  padding: 2rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.cell-time {
  flex: 0 0 84rpx;
  border-radius: 10rpx;
}

.cell-day {
  border-radius: 10rpx;
  min-height: 64rpx;
}

.day-label {
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.1;
}

.day-date {
  font-size: 18rpx;
  opacity: 0.85;
  line-height: 1.2;
}

.section-no {
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.1;
}

.section-time {
  font-size: 15rpx;
  line-height: 1.15;
}

.cell-course {
  border-radius: 10rpx;
  padding: 2rpx;
}

.course-name {
  font-size: 18rpx;
  font-weight: 600;
  line-height: 1.15;
  text-align: center;
  word-break: break-all;
}

.course-detail {
  font-size: 15rpx;
  line-height: 1.1;
  opacity: 0.85;
  text-align: center;
  word-break: break-all;
}

.course-badge {
  font-size: 14rpx;
  opacity: 0.8;
}

.week-hint {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 20rpx;
  padding: 6rpx 8rpx 0;
}

.week-arrow {
  padding: 4rpx 8rpx;
}

.week-current {
  opacity: 0.85;
}
