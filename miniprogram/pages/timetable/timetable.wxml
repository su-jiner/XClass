<view class="page" style="background:{{palette.page}};color:{{palette.textPrimary}}">
  <view class="header" style="padding-top:{{statusBarHeight}}px">
    <view bindtap="goCurrentWeek">
      <view class="header-week" style="color:{{palette.textPrimary}}">{{headerWeek}}</view>
      <view class="header-date" style="color:{{palette.textSecondary}}">{{headerDate}} · {{profileName}}</view>
    </view>
    <view class="add-button" bindtap="onAddTap" style="background:{{palette.buttonBackground}};color:{{palette.iconTint}}">＋</view>
  </view>

  <view class="grid" bindtouchstart="onTouchStart" bindtouchend="onTouchEnd">
    <view class="grid-row grid-head">
      <view class="cell cell-time" style="background:{{palette.gridHeader}};color:{{palette.textPrimary}}">{{monthLabel}}</view>
      <view
        class="cell cell-day"
        wx:for="{{dayHeaders}}"
        wx:key="label"
        style="background:{{item.background}};color:{{palette.textPrimary}}"
      >
        <view class="day-label">{{item.label}}</view>
        <view class="day-date">{{item.date}}</view>
      </view>
    </view>

    <scroll-view class="grid-body" scroll-y enable-flex>
      <view
        class="grid-row"
        wx:for="{{rows}}"
        wx:for-item="row"
        wx:for-index="rowIndex"
        wx:key="section"
        style="height:{{rowHeight}}rpx"
      >
        <view class="cell cell-time" style="background:{{palette.gridLeft}}">
          <view class="section-no" style="color:{{palette.textPrimary}}">{{row.section}}</view>
          <view class="section-time" style="color:{{palette.textSecondary}}">{{row.startTime}}</view>
          <view class="section-time" style="color:{{palette.textSecondary}}">{{row.endTime}}</view>
        </view>
        <view
          class="cell cell-course"
          wx:for="{{row.cells}}"
          wx:for-item="cell"
          wx:for-index="columnIndex"
          wx:key="columnIndex"
          data-row="{{rowIndex}}"
          data-column="{{columnIndex}}"
          bindtap="onCellTap"
          style="background:{{cell.empty ? (cell.isTodayColumn ? palette.gridDayToday : palette.gridDay) : cell.background}};color:{{cell.empty ? palette.textPrimary : cell.textColor}};border-radius:{{cell.empty ? '10rpx' : cell.radius}}"
        >
          <block wx:if="{{!cell.empty && cell.name}}">
            <view class="course-name">{{cell.name}}</view>
            <view class="course-detail" wx:if="{{cell.detail}}">{{cell.detail}}</view>
            <view class="course-badge" wx:if="{{cell.badge}}">{{cell.badge}}</view>
          </block>
        </view>
      </view>
    </scroll-view>
  </view>

  <view class="week-hint" style="color:{{palette.textSecondary}}">
    <text bindtap="goPrevWeek" class="week-arrow">‹ 上一周</text>
    <text class="week-current">第 {{week}} / {{totalWeeks}} 周（左右滑动切周）</text>
    <text bindtap="goNextWeek" class="week-arrow">下一周 ›</text>
  </view>
</view>
