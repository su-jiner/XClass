<view class="page" style="background:{{palette.page}};color:{{palette.textPrimary}}">
  <view class="header" style="padding-top:{{statusBarHeight}}px">
    <view class="header-left">
      <view bindtap="goCurrentWeek">
        <view class="header-week" style="color:{{palette.textPrimary}}">{{allModeHeader || headerWeek}}</view>
        <view class="header-date" wx:if="{{!isAllMode}}" style="color:{{palette.textSecondary}}">{{headerDate}} · {{profileName}}</view>
      </view>
      <view class="add-button" bindtap="onAddTap" style="background:{{palette.buttonBackground}};color:{{palette.iconTint}}">＋</view>
    </view>
  </view>

  <view class="grid" bindtouchstart="onTouchStart" bindtouchend="onTouchEnd">    <view class="grid-head">
      <view class="head-time" style="background:{{palette.gridHeader}};color:{{palette.textPrimary}}">{{monthLabel}}</view>
      <view
        class="head-day"
        wx:for="{{dayHeaders}}"
        wx:key="label"
        style="background:{{item.background}};color:{{palette.textPrimary}}"
      >
        <view class="day-label">{{item.label}}</view>
        <view class="day-date">{{item.date}}</view>
      </view>
    </view>

    <scroll-view class="grid-body" scroll-y enable-flex>
      <view class="grid-main">
        <view class="time-column">
          <view
            class="time-cell"
            wx:for="{{sections}}"
            wx:key="section"
            style="height:{{item.height}}rpx;background:{{palette.gridLeft}}"
          >
            <view class="section-no" style="color:{{palette.textPrimary}};font-size:{{24 * scale}}rpx">{{item.section}}</view>
            <view class="section-time" wx:if="{{item.startTime}}" style="color:{{palette.textSecondary}};font-size:{{18 * scale}}rpx">{{item.startTime}}</view>
            <view class="section-time" wx:if="{{item.endTime}}" style="color:{{palette.textSecondary}};font-size:{{18 * scale}}rpx">{{item.endTime}}</view>
          </view>
        </view>
        <view
          class="day-panel"
          wx:for="{{columns}}"
          wx:for-item="column"
          wx:for-index="dayIndex"
          wx:key="dayIndex"
          style="background:{{column.panelBg}};height:{{column.panelHeight}}rpx"
        >
          <view
            class="course-card"
            wx:for="{{column.courses}}"
            wx:for-item="course"
            wx:for-index="courseIndex"
            wx:key="courseIndex"
            data-day="{{dayIndex}}"
            data-course-index="{{courseIndex}}"
            bindtap="onCardTap"
            style="top:{{course.top}}rpx;height:{{course.height}}rpx;background:{{course.color}};color:{{course.textColor}};opacity:{{course.dimmed ? 0.6 : 1}}"
          >
            <view class="course-badge" wx:if="{{course.badge}}">{{course.badge}}</view>
            <view class="course-name" style="font-size:{{20 * scale}}rpx">{{course.name}}</view>
            <view class="course-detail" wx:if="{{course.location}}" style="font-size:{{17 * scale}}rpx">{{course.location}}</view>
          </view>
        </view>
      </view>
      <!-- 课表级备注：随课表内容一起滚动，滚动到底部才出现（非悬浮） -->
      <view class="notes-bar" wx:if="{{notes.length}}" style="background:{{palette.panelAlt}};border:1rpx solid {{palette.gridLeft}}">
        <view class="notes-title" style="color:{{palette.textPrimary}}">备注</view>
        <view class="notes-item" wx:for="{{notes}}" wx:key="*this" style="color:{{palette.textSecondary}}">{{item}}</view>
      </view>
    </scroll-view>
  </view>

  <view class="week-hint" wx:if="{{!isAllMode}}" style="color:{{palette.textSecondary}}">
    <text bindtap="goPrevWeek" class="week-arrow">‹ 上一周</text>
    <text class="week-current">第 {{week}} / {{totalWeeks}} 周（左右滑动切周）</text>
    <text bindtap="goNextWeek" class="week-arrow">下一周 ›</text>
  </view>

  <view class="manual-mask" wx:if="{{showPaste}}" bindtap="closePaste">
    <view class="manual-panel" catchtap="noop" style="background:{{palette.panel}}">
      <view class="manual-title" style="color:{{palette.textPrimary}}">粘贴文本导入</view>
      <view class="manual-label" style="color:{{palette.textSecondary}}">粘贴朋友分享的 XClass 课表文本（仅本软件可识别），解析后可预览编辑再确认导入。</view>
      <textarea class="paste-area" style="background:{{palette.panelAlt}};color:{{palette.textPrimary}}"
        value="{{pasteText}}" bindinput="onPasteInput" placeholder="在此粘贴课表分享文本…" placeholder-class="manual-ph" />
      <view class="manual-actions">
        <view class="manual-btn" style="background:{{palette.panelAlt}};color:{{palette.textPrimary}}" bindtap="closePaste">取消</view>
        <view class="manual-btn" style="background:{{palette.panelAlt}};color:{{palette.textPrimary}}" bindtap="exportShareTextFromDialog">导出当前课表</view>
        <view class="manual-btn manual-btn-primary" style="background:{{palette.buttonBackground}};color:{{palette.buttonText}}" bindtap="doPasteParse">解析预览</view>
      </view>
    </view>
  </view>

  <view class="manual-mask" wx:if="{{showManual}}" bindtap="closeManual">
    <view class="manual-panel" catchtap="noop" style="background:{{palette.panel}}">
      <view class="manual-title" style="color:{{palette.textPrimary}}">{{manualTitle}}</view>

      <view class="manual-field">
        <view class="manual-label" style="color:{{palette.textSecondary}}">课程名称</view>
        <input class="manual-input" style="background:{{palette.panelAlt}};color:{{palette.textPrimary}}"
          value="{{manualForm.name}}" data-field="name" bindinput="onManualField" placeholder="课程名称" placeholder-class="manual-ph" />
      </view>

      <view class="manual-row">
        <view class="manual-half">
          <view class="manual-label" style="color:{{palette.textSecondary}}">星期</view>
          <picker mode="selector" range="{{weekdayNames}}" value="{{manualForm.weekdayIndex}}" bindchange="onManualWeekday">
            <view class="manual-input manual-picker" style="background:{{palette.panelAlt}};color:{{palette.textPrimary}}">{{weekdayNames[manualForm.weekdayIndex]}} ▾</view>
          </picker>
        </view>
        <view class="manual-half">
          <view class="manual-label" style="color:{{palette.textSecondary}}">周次</view>
          <input class="manual-input" style="background:{{palette.panelAlt}};color:{{palette.textPrimary}}"
            value="{{manualForm.weekText}}" data-field="weekText" bindinput="onManualField" placeholder="如 1-16周 / 3-9周(单)" placeholder-class="manual-ph" />
        </view>
      </view>

      <view class="manual-row">
        <view class="manual-half">
          <view class="manual-label" style="color:{{palette.textSecondary}}">开始节</view>
          <input class="manual-input" type="number" style="background:{{palette.panelAlt}};color:{{palette.textPrimary}}"
            value="{{manualForm.startSection}}" data-field="startSection" bindinput="onManualField" />
        </view>
        <view class="manual-half">
          <view class="manual-label" style="color:{{palette.textSecondary}}">结束节</view>
          <input class="manual-input" type="number" style="background:{{palette.panelAlt}};color:{{palette.textPrimary}}"
            value="{{manualForm.endSection}}" data-field="endSection" bindinput="onManualField" />
        </view>
      </view>

      <view class="manual-row">
        <view class="manual-half">
          <view class="manual-label" style="color:{{palette.textSecondary}}">自定义开始（可留空）</view>
          <input class="manual-input" style="background:{{palette.panelAlt}};color:{{palette.textPrimary}}"
            value="{{manualForm.customStart}}" data-field="customStart" bindinput="onManualField" placeholder="如 09:00" placeholder-class="manual-ph" />
        </view>
        <view class="manual-half">
          <view class="manual-label" style="color:{{palette.textSecondary}}">自定义结束（可留空）</view>
          <input class="manual-input" style="background:{{palette.panelAlt}};color:{{palette.textPrimary}}"
            value="{{manualForm.customEnd}}" data-field="customEnd" bindinput="onManualField" placeholder="如 10:40" placeholder-class="manual-ph" />
        </view>
      </view>
      <view class="manual-hint" style="color:{{palette.textSecondary}}">留空则按节次默认时间（如第3-4节 10:00-11:40）</view>

      <view class="manual-field">
        <view class="manual-label" style="color:{{palette.textSecondary}}">上课地点（可留空）</view>
        <input class="manual-input" style="background:{{palette.panelAlt}};color:{{palette.textPrimary}}"
          value="{{manualForm.location}}" data-field="location" bindinput="onManualField" placeholder="如 教三302" placeholder-class="manual-ph" />
      </view>

      <view class="manual-field">
        <view class="manual-label" style="color:{{palette.textSecondary}}">授课教师（可留空）</view>
        <input class="manual-input" style="background:{{palette.panelAlt}};color:{{palette.textPrimary}}"
          value="{{manualForm.teacher}}" data-field="teacher" bindinput="onManualField" placeholder="如 张三" placeholder-class="manual-ph" />
      </view>

      <view class="manual-actions">
        <view class="manual-btn" style="background:{{palette.panelAlt}};color:{{palette.textPrimary}}" bindtap="closeManual">取消</view>
        <view class="manual-btn manual-btn-primary" style="background:{{palette.buttonBackground}};color:{{palette.buttonText}}" bindtap="saveManual">保存</view>
      </view>
    </view>
  </view>

  <!-- 课程详情弹层：重叠课程左右滑动切换查看 -->
  <view class="detail-mask" wx:if="{{showDetail}}" bindtap="closeDetail">
    <view class="detail-panel" catchtap="noop" style="background:{{palette.panel}}">
      <view class="detail-head">
        <text class="detail-title" style="color:{{palette.textPrimary}}">{{detailCourses[detailIndex].name}}</text>
        <text class="detail-count" wx:if="{{detailCourses.length > 1}}" style="color:{{palette.textSecondary}}">{{detailIndex + 1}} / {{detailCourses.length}}</text>
      </view>
      <swiper class="detail-swiper" current="{{detailIndex}}" bindchange="onDetailChange">
        <swiper-item wx:for="{{detailCourses}}" wx:key="courseIndex">
          <view class="detail-content">
            <view class="detail-row">
              <text class="detail-label" style="color:{{palette.textSecondary}}">教师</text>
              <text class="detail-value" style="color:{{palette.textPrimary}}">{{item.teacher}}</text>
            </view>
            <view class="detail-row">
              <text class="detail-label" style="color:{{palette.textSecondary}}">地点</text>
              <text class="detail-value" style="color:{{palette.textPrimary}}">{{item.location}}</text>
            </view>
            <view class="detail-row">
              <text class="detail-label" style="color:{{palette.textSecondary}}">节次</text>
              <text class="detail-value" style="color:{{palette.textPrimary}}">{{item.sectionText}} {{item.timeText}}</text>
            </view>
            <view class="detail-row">
              <text class="detail-label" style="color:{{palette.textSecondary}}">周次</text>
              <text class="detail-value" style="color:{{palette.textPrimary}}">{{item.weekText}}</text>
            </view>
          </view>
        </swiper-item>
      </swiper>
      <view class="detail-actions">
        <view class="manual-btn" style="background:{{palette.panelAlt}};color:{{palette.textPrimary}}" bindtap="editDetail">编辑课程</view>
        <view class="manual-btn manual-btn-danger" style="background:{{palette.panelAlt}};color:#e64340" bindtap="deleteDetail">删除课程</view>
      </view>
    </view>
  </view>
</view>
