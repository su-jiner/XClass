<view class="page" style="background:{{palette.page}};color:{{palette.text}}">
  <view class="page-header">
    <view>
      <view style="font-size:40rpx;font-weight:700">第{{weekIndex + 1}}周{{weekIndex + 1 === currentWeek ? '（本周）' : '（非本周）'}}</view>
      <view class="page-subtitle">{{profileName}} · 共{{weeks}}周</view>
    </view>
    <view class="add-button" bindtap="onAddTap" style="background:{{palette.panelAlt}};color:{{palette.icon}}">＋</view>
  </view>

  <swiper
    class="week-swiper"
    current="{{weekIndex}}"
    bindchange="onWeekChange"
    duration="280"
    style="height:calc(100vh - 360rpx)"
  >
    <swiper-item wx:for="{{grids}}" wx:key="index">
      <scroll-view scroll-y style="height:100%">
        <view class="grid-header" style="background:{{palette.panel}}">
          <view class="grid-cell grid-time muted">节次</view>
          <view class="grid-cell muted" wx:for="{{columnLabels}}" wx:for-item="label" wx:key="*this">{{label}}</view>
        </view>
        <view class="grid-row" wx:for="{{rowLabels}}" wx:for-item="rowLabel" wx:for-index="rowIndex" wx:key="*this">
          <view class="grid-cell grid-time" style="background:{{palette.panelAlt}}">
            <view>{{rowLabel}}</view>
            <view class="muted">{{sectionRanges[rowIndex * 2]}}</view>
          </view>
          <view
            class="grid-cell course-cell"
            wx:for="{{grids[weekIndex][rowIndex]}}"
            wx:for-item="cellText"
            wx:key="index"
            style="background:{{cellText ? palette.panelAlt : palette.panel}};color:{{palette.text}}"
          >{{cellText}}</view>
        </view>
      </scroll-view>
    </swiper-item>
  </swiper>
</view>
