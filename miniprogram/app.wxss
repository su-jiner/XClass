page {
  background: #f7e7cc;
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
}

.page {
  min-height: 100vh;
  padding: 0 24rpx 140rpx;
  box-sizing: border-box;
}

.page-header {
  padding: 12rpx 8rpx 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.page-title {
  font-size: 44rpx;
  font-weight: 700;
}

.page-subtitle {
  font-size: 24rpx;
  opacity: 0.7;
  margin-top: 6rpx;
}

.card {
  border-radius: 28rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(60, 40, 20, 0.06);
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 4rpx;
}

.row-label {
  font-size: 28rpx;
}

.row-value {
  font-size: 26rpx;
  opacity: 0.75;
}

.divider {
  height: 1rpx;
  opacity: 0.12;
  margin: 4rpx 0;
}

.button {
  border-radius: 22rpx;
  padding: 22rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  margin-top: 16rpx;
}

.button.secondary {
  font-weight: 500;
  opacity: 0.85;
}

.segment {
  display: flex;
  border-radius: 20rpx;
  padding: 6rpx;
  margin-bottom: 16rpx;
}

.segment-item {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  padding: 14rpx 0;
  border-radius: 16rpx;
}

.muted {
  font-size: 24rpx;
  opacity: 0.7;
}

.chip {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
}

.input {
  border-radius: 18rpx;
  padding: 18rpx;
  font-size: 28rpx;
  margin-top: 12rpx;
}
