<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="18dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="28sp"
            android:textStyle="bold"
            android:letterSpacing="0.02" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="20dp"
            android:text="@string/settings_intro"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="13sp" />

        <!-- 课表管理 -->
        <LinearLayout
            android:id="@+id/settingsCardTimetable"
            style="@style/SettingsCard">

            <LinearLayout style="@style/SettingsCardHeader">
                <ImageView
                    android:id="@+id/iconTimetable"
                    style="@style/SettingsCardIcon"
                    android:src="@drawable/ic_settings_calendar"
                    android:contentDescription="@null" />
                <TextView
                    style="@style/SettingsCardTitle"
                    android:text="@string/settings_timetable_manage" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/rowManageTimetable"
                style="@style/SettingsRow">
                <TextView
                    style="@style/SettingsRowLabel"
                    android:text="@string/settings_open_timetable_manage" />
                <ImageView style="@style/SettingsRowChevron" android:contentDescription="@null" />
            </LinearLayout>

            <View
                android:id="@+id/dividerTimetable"
                style="@style/SettingsDivider" />

            <LinearLayout
                android:id="@+id/rowTimeProfiles"
                style="@style/SettingsRow">
                <TextView
                    style="@style/SettingsRowLabel"
                    android:text="@string/settings_time_profiles" />
                <TextView
                    android:id="@+id/timeProfilesValue"
                    style="@style/SettingsRowValue" />
                <ImageView style="@style/SettingsRowChevron" android:contentDescription="@null" />
            </LinearLayout>

            <View style="@style/SettingsDivider" />

            <LinearLayout
                android:id="@+id/rowSemesterStart"
                style="@style/SettingsRow">
                <TextView
                    style="@style/SettingsRowLabel"
                    android:text="@string/settings_row_first_week" />
                <TextView
                    android:id="@+id/semesterStartDateText"
                    style="@style/SettingsRowValue" />
                <ImageView style="@style/SettingsRowChevron" android:contentDescription="@null" />
            </LinearLayout>

            <View style="@style/SettingsDivider" />

            <LinearLayout style="@style/SettingsFieldLabel">
                <TextView
                    style="@style/SettingsRowLabel"
                    android:text="@string/settings_row_default_open" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/defaultOpenGroup"
                style="@style/SettingsSegment">
                <TextView
                    android:id="@+id/defaultOpenTimetable"
                    style="@style/SettingsSegmentButton"
                    android:text="@string/nav_timetable" />
                <TextView
                    android:id="@+id/defaultOpenToday"
                    style="@style/SettingsSegmentButton"
                    android:text="@string/nav_today" />
            </LinearLayout>
        </LinearLayout>

        <!-- 外观 -->
        <LinearLayout
            android:id="@+id/settingsCardAppearance"
            style="@style/SettingsCard">

            <LinearLayout style="@style/SettingsCardHeader">
                <ImageView
                    android:id="@+id/iconAppearance"
                    style="@style/SettingsCardIcon"
                    android:src="@drawable/ic_settings_palette"
                    android:contentDescription="@null" />
                <TextView
                    style="@style/SettingsCardTitle"
                    android:text="@string/settings_appearance" />
            </LinearLayout>

            <LinearLayout style="@style/SettingsFieldLabel">
                <TextView
                    style="@style/SettingsRowLabel"
                    android:text="@string/settings_theme" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/themeGroup"
                style="@style/SettingsSegment">
                <TextView
                    android:id="@+id/themeWarm"
                    style="@style/SettingsSegmentButton"
                    android:text="@string/settings_theme_warm" />
                <TextView
                    android:id="@+id/themeOcean"
                    style="@style/SettingsSegmentButton"
                    android:text="@string/settings_theme_ocean" />
                <TextView
                    android:id="@+id/themeMint"
                    style="@style/SettingsSegmentButton"
                    android:text="@string/settings_theme_mint" />
                <TextView
                    android:id="@+id/themeSakura"
                    style="@style/SettingsSegmentButton"
                    android:text="@string/settings_theme_sakura" />
                <TextView
                    android:id="@+id/themeMidnight"
                    style="@style/SettingsSegmentButton"
                    android:text="@string/settings_theme_midnight" />
            </LinearLayout>

            <LinearLayout style="@style/SettingsFieldLabel">
                <TextView
                    style="@style/SettingsRowLabel"
                    android:text="@string/settings_dark_mode" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/darkModeGroup"
                style="@style/SettingsSegment">
                <TextView
                    android:id="@+id/darkModeSystem"
                    style="@style/SettingsSegmentButton"
                    android:text="@string/settings_dark_follow_system" />
                <TextView
                    android:id="@+id/darkModeLight"
                    style="@style/SettingsSegmentButton"
                    android:text="@string/settings_dark_light" />
                <TextView
                    android:id="@+id/darkModeDark"
                    style="@style/SettingsSegmentButton"
                    android:text="@string/settings_dark_dark" />
            </LinearLayout>

            <LinearLayout style="@style/SettingsFieldLabel">
                <TextView
                    style="@style/SettingsRowLabel"
                    android:text="@string/settings_font_scale" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/fontScaleGroup"
                style="@style/SettingsSegment">
                <TextView
                    android:id="@+id/fontSmall"
                    style="@style/SettingsSegmentButton"
                    android:text="@string/settings_font_small" />
                <TextView
                    android:id="@+id/fontNormal"
                    style="@style/SettingsSegmentButton"
                    android:text="@string/settings_font_normal" />
                <TextView
                    android:id="@+id/fontLarge"
                    style="@style/SettingsSegmentButton"
                    android:text="@string/settings_font_large" />
            </LinearLayout>

            <View
                android:id="@+id/dividerAppearance"
                style="@style/SettingsDivider" />

            <LinearLayout style="@style/SettingsRow">
                <TextView
                    style="@style/SettingsRowLabel"
                    android:text="@string/settings_show_non_current" />
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/showNonCurrentSwitch"
                    style="@style/SettingsRowSwitch" />
            </LinearLayout>
        </LinearLayout>

        <!-- 上课提醒 -->
        <LinearLayout
            android:id="@+id/settingsCardReminder"
            style="@style/SettingsCard">

            <LinearLayout style="@style/SettingsCardHeader">
                <ImageView
                    android:id="@+id/iconReminder"
                    style="@style/SettingsCardIcon"
                    android:src="@drawable/ic_settings_bell"
                    android:contentDescription="@null" />
                <TextView
                    style="@style/SettingsCardTitle"
                    android:text="@string/settings_reminder" />
            </LinearLayout>

            <LinearLayout style="@style/SettingsRow">
                <TextView
                    style="@style/SettingsRowLabel"
                    android:text="@string/settings_reminder_enable" />
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/reminderSwitch"
                    style="@style/SettingsRowSwitch" />
            </LinearLayout>

            <View style="@style/SettingsDivider" />

            <LinearLayout
                android:id="@+id/rowReminderTime"
                style="@style/SettingsRow">
                <TextView
                    style="@style/SettingsRowLabel"
                    android:text="@string/settings_row_reminder_time" />
                <TextView
                    android:id="@+id/reminderTimeText"
                    style="@style/SettingsRowValue" />
                <ImageView style="@style/SettingsRowChevron" android:contentDescription="@null" />
            </LinearLayout>
        </LinearLayout>

        <!-- 自定义背景 -->
        <LinearLayout
            android:id="@+id/settingsCardBackground"
            style="@style/SettingsCard">

            <LinearLayout style="@style/SettingsCardHeader">
                <ImageView
                    android:id="@+id/iconBackground"
                    style="@style/SettingsCardIcon"
                    android:src="@drawable/ic_settings_wallpaper"
                    android:contentDescription="@null" />
                <TextView
                    style="@style/SettingsCardTitle"
                    android:text="@string/settings_custom_background" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/rowChooseBackground"
                style="@style/SettingsRow">
                <TextView
                    style="@style/SettingsRowLabel"
                    android:text="@string/settings_choose_crop" />
                <ImageView style="@style/SettingsRowChevron" android:contentDescription="@null" />
            </LinearLayout>

            <View style="@style/SettingsDivider" />

            <LinearLayout
                android:id="@+id/rowClearBackground"
                style="@style/SettingsRow">
                <TextView
                    style="@style/SettingsRowLabel"
                    android:text="@string/settings_restore_default" />
                <ImageView style="@style/SettingsRowChevron" android:contentDescription="@null" />
            </LinearLayout>

            <TextView
                style="@style/SettingsCardHint"
                android:text="@string/settings_background_hint" />
        </LinearLayout>

        <!-- 数据管理 -->
        <LinearLayout
            android:id="@+id/settingsCardData"
            style="@style/SettingsCard">

            <LinearLayout style="@style/SettingsCardHeader">
                <ImageView
                    android:id="@+id/iconData"
                    style="@style/SettingsCardIcon"
                    android:src="@drawable/ic_settings_folder"
                    android:contentDescription="@null" />
                <TextView
                    style="@style/SettingsCardTitle"
                    android:text="@string/settings_data" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/rowExportText"
                style="@style/SettingsRow">
                <TextView
                    style="@style/SettingsRowLabel"
                    android:text="@string/settings_export_text" />
                <ImageView style="@style/SettingsRowChevron" android:contentDescription="@null" />
            </LinearLayout>

            <View style="@style/SettingsDivider" />

            <LinearLayout
                android:id="@+id/rowBackup"
                style="@style/SettingsRow">
                <TextView
                    style="@style/SettingsRowLabel"
                    android:text="@string/settings_backup" />
                <ImageView style="@style/SettingsRowChevron" android:contentDescription="@null" />
            </LinearLayout>

            <View style="@style/SettingsDivider" />

            <LinearLayout
                android:id="@+id/rowRestore"
                style="@style/SettingsRow">
                <TextView
                    style="@style/SettingsRowLabel"
                    android:text="@string/settings_restore" />
                <ImageView style="@style/SettingsRowChevron" android:contentDescription="@null" />
            </LinearLayout>
        </LinearLayout>

        <!-- 关于 -->
        <LinearLayout
            android:id="@+id/settingsCardAbout"
            style="@style/SettingsCard">

            <LinearLayout style="@style/SettingsCardHeader">
                <ImageView
                    android:id="@+id/iconAbout"
                    style="@style/SettingsCardIcon"
                    android:src="@drawable/ic_tool_web"
                    android:contentDescription="@null" />
                <TextView
                    style="@style/SettingsCardTitle"
                    android:text="@string/settings_about" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/rowVersion"
                style="@style/SettingsRow">
                <TextView
                    style="@style/SettingsRowLabel"
                    android:text="@string/settings_app_version" />
                <TextView
                    android:id="@+id/updateVersionText"
                    style="@style/SettingsRowValue" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/settingsFooterVersion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="XClass"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="12sp"
            android:layout_marginTop="8dp" />
    </LinearLayout>
</ScrollView>
