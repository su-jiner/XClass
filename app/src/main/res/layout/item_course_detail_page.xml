<?xml version="1.0" encoding="utf-8"?>
<!-- 重叠课程详情分页的单页：一门课程一页，左右滑动切换 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="4dp"
    android:paddingEnd="4dp">

    <!-- 课程名 -->
    <TextView
        android:id="@+id/detailTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="19sp"
        android:textStyle="bold" />

    <!-- 时间横幅：与课表格子同色系，强化视觉关联 -->
    <LinearLayout
        android:id="@+id/detailBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="10dp"
        android:foreground="?attr/selectableItemBackground"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/detailBannerSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/detailBannerTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- 信息行：图标圆片 + 标签 + 值，点击复制 -->
    <LinearLayout
        android:id="@+id/rowTeacher"
        style="@style/CourseDetailRow">
        <FrameLayout style="@style/CourseDetailIconChip">
            <ImageView
                android:id="@+id/detailIconTeacher"
                style="@style/CourseDetailIcon"
                android:src="@drawable/ic_detail_person"
                android:contentDescription="@null" />
        </FrameLayout>
        <TextView
            style="@style/CourseDetailLabel"
            android:text="@string/course_detail_teacher" />
        <TextView
            android:id="@+id/detailTeacher"
            style="@style/CourseDetailValue" />
    </LinearLayout>

    <View
        android:id="@+id/dividerOne"
        style="@style/CourseDetailDivider" />

    <LinearLayout
        android:id="@+id/rowLocation"
        style="@style/CourseDetailRow">
        <FrameLayout style="@style/CourseDetailIconChip">
            <ImageView
                android:id="@+id/detailIconLocation"
                style="@style/CourseDetailIcon"
                android:src="@drawable/ic_detail_place"
                android:contentDescription="@null" />
        </FrameLayout>
        <TextView
            style="@style/CourseDetailLabel"
            android:text="@string/course_detail_location" />
        <TextView
            android:id="@+id/detailLocation"
            style="@style/CourseDetailValue" />
    </LinearLayout>

    <View
        android:id="@+id/dividerTwo"
        style="@style/CourseDetailDivider" />

    <LinearLayout
        android:id="@+id/rowWeeks"
        style="@style/CourseDetailRow">
        <FrameLayout style="@style/CourseDetailIconChip">
            <ImageView
                android:id="@+id/detailIconWeeks"
                style="@style/CourseDetailIcon"
                android:src="@drawable/ic_detail_week"
                android:contentDescription="@null" />
        </FrameLayout>
        <TextView
            style="@style/CourseDetailLabel"
            android:text="@string/course_detail_weeks" />
        <TextView
            android:id="@+id/detailWeeks"
            style="@style/CourseDetailValue" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/rowSemester"
        style="@style/CourseDetailRow">
        <FrameLayout style="@style/CourseDetailIconChip">
            <ImageView
                android:id="@+id/detailIconSemester"
                style="@style/CourseDetailIcon"
                android:src="@drawable/ic_detail_semester"
                android:contentDescription="@null" />
        </FrameLayout>
        <TextView
            style="@style/CourseDetailLabel"
            android:text="@string/course_detail_semester" />
        <TextView
            android:id="@+id/detailMeta"
            style="@style/CourseDetailValue" />
    </LinearLayout>

    <TextView
        android:id="@+id/detailCopyHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="@string/course_detail_copy_hint"
        android:textSize="11sp" />
</LinearLayout>
