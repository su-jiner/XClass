<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <LinearLayout
        android:layout_width="46dp"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/timelineItemTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#1B2430"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/timelineItemEnd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#718096"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/timelineItemName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#1B2430"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/timelineItemBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#22E36A3A"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="进行中"
                android:textColor="#E36A3A"
                android:textSize="10sp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/timelineItemDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#718096"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
